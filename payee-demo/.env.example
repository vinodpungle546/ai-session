# payee-demo — copy to .env and fill in. Never commit .env.
# Every value below has a safe default in app/config.py, so the app still
# imports if a variable is missing.

# --- Model backend -----------------------------------------------------
# The demo is swappable by config alone: change MODEL_PROVIDER and the
# matching keys, and nothing else in the codebase needs to change.
#
# MODEL_PROVIDER: "openai_compatible" | "anthropic"
#   openai_compatible — any OpenAI-protocol endpoint (OpenAI, vLLM, Ollama,
#                       GLM, Together, ...). Set MODEL_BASE_URL for non-OpenAI.
#   anthropic         — the Anthropic API. MODEL_BASE_URL is ignored.
MODEL_PROVIDER=openai_compatible
MODEL_NAME=gpt-4o-mini
MODEL_API_KEY=sk-replace-me
# Leave blank to use the provider's default endpoint.
MODEL_BASE_URL=

# --- Telemetry ---------------------------------------------------------
# TELEMETRY_BACKEND: "phoenix" | "langfuse"
# The same OpenTelemetry instrumentation exports to either one.
TELEMETRY_BACKEND=phoenix

# Used when TELEMETRY_BACKEND=phoenix. Run Phoenix locally with:
#   phoenix serve
PHOENIX_ENDPOINT=http://localhost:6006/v1/traces

# Used when TELEMETRY_BACKEND=langfuse.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_SECRET_KEY=sk-lf-replace-me

# --- Feature flags -----------------------------------------------------
# Each is re-read per run, so the Streamlit sidebar can toggle them live.

# RAG grounding. When false, retrieve() returns [] with no fallback.
GROUNDING_ENABLED=true

# Two-layer confidence check. When false, nothing is blocked AND no judge
# call is made (the cost difference is part of the demo).
GUARDRAILS_ENABLED=true

# Block when final confidence falls below this.
CONFIDENCE_THRESHOLD=0.75

# Sampling temperature for the LLM judge only. Slightly above zero so the
# written rationale varies run to run; the deterministic floor is what
# guarantees the block, so this variation is safe.
JUDGE_TEMPERATURE=0.3
